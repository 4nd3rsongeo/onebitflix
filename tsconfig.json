{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react",
    "module": "NodeNext",
    "rootDir": "./src",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "noPropertyAccessFromIndexSignature": false,
    "skipLibCheck": true
  }
}
